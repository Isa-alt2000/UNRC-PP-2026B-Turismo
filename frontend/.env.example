# Todo lo que empieza con VITE_ termina en el JavaScript público: nunca pongas secretos aquí.

# Prefijo de la API. Debe ser igual a API_PREFIX en backend/.env.
VITE_API_PREFIX=

# A dónde reenvía el proxy de Vite las peticiones del prefijo. Solo lo lee vite.config.ts.
BACKEND_URL=

# Hosts externos que pueden abrir el servidor de Vite, separados por comas. Solo lo lee
# vite.config.ts. Un punto inicial acepta cualquier subdominio. Vacío: solo localhost.
# Ejemplo para túneles de Cloudflare: ALLOWED_HOSTS=.trycloudflare.com
ALLOWED_HOSTS=
